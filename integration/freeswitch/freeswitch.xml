<?xml version="1.0"?>
<!--
  A minimal FreeSWITCH configuration for the integration bench: the
  modules a SIP call needs, and contrib/freeswitch's profile and dialplan
  (mounted at /etc/freeswitch/contrib), unchanged.
-->
<document type="freeswitch/xml">

  <section name="configuration" description="Configuration">
    <configuration name="switch.conf" description="Core">
      <settings>
        <param name="max-sessions" value="100"/>
        <param name="sessions-per-second" value="30"/>
        <param name="loglevel" value="info"/>
        <param name="rtp-start-port" value="16384"/>
        <param name="rtp-end-port" value="16583"/>
      </settings>
    </configuration>

    <configuration name="modules.conf" description="Modules">
      <modules>
        <load module="mod_console"/>
        <load module="mod_commands"/>
        <load module="mod_dptools"/>
        <load module="mod_dialplan_xml"/>
        <load module="mod_tone_stream"/>
        <!-- G.722 (and other codecs). -->
        <load module="mod_spandsp"/>
        <load module="mod_event_socket"/>
        <load module="mod_sofia"/>
      </modules>
    </configuration>

    <configuration name="console.conf" description="Console">
      <mappings>
        <map name="all" value="console,debug,info,notice,warning,err,crit,alert"/>
      </mappings>
      <settings>
        <param name="colorize" value="false"/>
        <param name="loglevel" value="info"/>
      </settings>
    </configuration>

    <!-- fs_cli, from inside the container. -->
    <configuration name="event_socket.conf" description="Event socket">
      <settings>
        <param name="listen-ip" value="127.0.0.1"/>
        <param name="listen-port" value="8021"/>
        <param name="password" value="ClueCon"/>
      </settings>
    </configuration>

    <!-- The bench's Kamailio for FreeSWITCH. -->
    <configuration name="acl.conf" description="ACLs">
      <network-lists>
        <list name="rtpflux_proxies" default="deny">
          <node type="allow" cidr="172.30.89.15/32"/>
          <node type="allow" cidr="172.30.89.18/32"/>
        </list>
      </network-lists>
    </configuration>

    <configuration name="sofia.conf" description="SIP">
      <global_settings>
        <param name="log-level" value="0"/>
      </global_settings>
      <profiles>
        <X-PRE-PROCESS cmd="include" data="contrib/sip_profiles/rtpflux.xml"/>
      </profiles>
    </configuration>
  </section>

  <section name="dialplan" description="Dialplan">
    <X-PRE-PROCESS cmd="include" data="contrib/dialplan/rtpflux.xml"/>
  </section>
</document>
